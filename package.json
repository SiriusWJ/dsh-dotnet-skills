{
  "name": "dsh-dotnet-skills",
  "version": "2.2.3",
  "private": true,
  "type": "module",
  "description": "Project-scoped .NET skills for DeepSeek Harness: the composer button reads the project, the current model picks from a 203-skill catalog, and the selection is copied into the project (two copies) and kept in sync; optional Microsoft Learn MCP + CLI.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  }
}
