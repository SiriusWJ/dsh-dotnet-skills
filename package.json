{
  "name": "dsh-dotnet-skills",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Project-scoped .NET skills for DeepSeek Harness: a composer button analyses the project, suggests the matching .NET skills, and injects only those into the project's own skill root.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
